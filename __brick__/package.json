{
  "name": "{{applicationName.paramCase()}}",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev --port {{port}}",
    "dev:https": "next dev --port {{port}} --experimental-https",
    "start": "next start --port {{port}}",
    "build": "next build",
    "lint": "next typegen && tsc && eslint",
    "lint:fix": "next typegen && tsc && eslint --fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dotenv-run/core": "^1.3.8",
    "@hookform/resolvers": "^7.0.1",
    "@sentry/nextjs": "^11.10.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-query-devtools": "5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "he": "^2.0.0",
    "lucide-react": "^1.46.0",
    "next": "16.4.4",
    "next-intl": "^4.14.3",
    "nextjs-toploader": "^3.7.15",
    "nuqs": "^2.2.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@tailwindcss/turbopack": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.1.11",
    "eslint-plugin-unused-imports": "^4.0.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "shadcn": "^4.21.0",
    "storybook": "^10.1.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "environment"
        ]
      }
    }
  }
}
