# Frontend env. Values live in the monorepo's root .env (loaded by
# next.config.ts); this file documents them. {{applicationName.constantCase()}}_* are read on the server
# at runtime; only NEXT_PUBLIC_{{applicationName.constantCase()}}_* reach the browser bundle — never put
# a secret behind that prefix.

# ── Site identity ────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonicals, robots and sitemap.
{{applicationName.constantCase()}}_DOMAIN=http://localhost:{{port}}
# Site name used in metadata titles and as the logo fallback.
{{applicationName.constantCase()}}_SITE_NAME=

# ── Cache ────────────────────────────────────────────────
# Bearer secret for POST /api/revalidate. Set the same value in whatever
# notifies the frontend of content changes (CMS webhook, ops script…).
# Generate with: openssl rand -hex 32
{{applicationName.constantCase()}}_REVALIDATE_SECRET=

# ── Sentry ───────────────────────────────────────────────
# Build-time only: uploads source maps. Leave empty locally.
{{applicationName.constantCase()}}_SENTRY_AUTH_TOKEN=
{{applicationName.constantCase()}}_SENTRY_ORG=
{{applicationName.constantCase()}}_SENTRY_PROJECT=
NEXT_PUBLIC_{{applicationName.constantCase()}}_SENTRY_DSN=
# `true` or `1` to report errors.
NEXT_PUBLIC_{{applicationName.constantCase()}}_SENTRY_ENABLED=false
